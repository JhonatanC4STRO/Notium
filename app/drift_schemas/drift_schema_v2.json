  "fixed_sql": [
    {
      "name": "notas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notas\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'PENDING', \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"version\" INTEGER NOT NULL DEFAULT 1, \"device_id\" TEXT NULL, \"sincronizado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sincronizado\" IN (0, 1)), \"uuid\" TEXT NOT NULL, \"usuario_uuid\" TEXT NOT NULL, \"titulo\" TEXT NOT NULL, \"contenido\" TEXT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "adjuntos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"adjuntos\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'PENDING', \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"version\" INTEGER NOT NULL DEFAULT 1, \"device_id\" TEXT NULL, \"sincronizado\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sincronizado\" IN (0, 1)), \"uuid\" TEXT NOT NULL, \"nota_uuid\" TEXT NOT NULL REFERENCES notas (uuid), \"ruta_local\" TEXT NULL, \"url_remota\" TEXT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "historial_cambios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"historial_cambios\" (\"uuid\" TEXT NOT NULL, \"nota_uuid\" TEXT NOT NULL REFERENCES notas (uuid), \"tipo_cambio\" TEXT NOT NULL, \"origen_cambio\" TEXT NOT NULL, \"fecha\" TEXT NOT NULL, \"dispositivo_origen\" TEXT NULL, \"valor_anterior\" TEXT NULL, \"valor_nuevo\" TEXT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "usuarios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"usuarios\" (\"uuid\" TEXT NOT NULL, \"nombre\" TEXT NOT NULL, \"email\" TEXT NOT NULL, PRIMARY KEY (\"uuid\"));"
