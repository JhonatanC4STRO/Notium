<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Solo en DEBUG: permite HTTP sin TLS hacia el backend local de
         desarrollo (http://10.0.2.2:3000). Android 9+ lo bloquea por
         defecto. Los builds release no llevan esto: producción va por
         HTTPS obligatorio (sección 8 del doc). -->
    <application android:usesCleartextTraffic="true" />
</manifest>
