# Copiar como .env.production en el VPS. No subir el archivo real a Git.

# Subdominio cuyo registro DNS A/AAAA apunta al VPS, sin https:// ni rutas.
NOTIUM_DOMAIN=api.notium.example.com

# Correo usado por Let's Encrypt para avisos relacionados con el certificado.
ACME_EMAIL=tu-correo@example.com

# Generar cada valor con: openssl rand -hex 48
POSTGRES_PASSWORD=reemplazar-con-una-contrasena-fuerte
JWT_SECRET=reemplazar-con-96-caracteres-hexadecimales
JWT_REFRESH_SECRET=reemplazar-con-otros-96-caracteres-hexadecimales
