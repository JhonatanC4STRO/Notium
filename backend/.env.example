# Copiar a .env y ajustar. Nunca commitear el .env real (sección 8: manejo de secretos).

# Conexión a PostgreSQL (usada por la app y por node-pg-migrate)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notium

# Secretos JWT (sección 8: access + refresh). Generar valores aleatorios largos,
# por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-largo
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-aleatorio-largo

# Puerto HTTP del servidor local de desarrollo (openapi.yaml: http://localhost:3000/v1)
PORT=3000

# Opcionales — vigencia de los tokens JWT en segundos (defaults: 900 = 15 min, 2592000 = 30 días)
# JWT_ACCESS_TTL_SEGUNDOS=900
# JWT_REFRESH_TTL_SEGUNDOS=2592000
